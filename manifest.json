{
  "manifest_version": 3,
  "name": "Data Helper",
  "description": "Türkçe test verisi: geçerli TCKN, VKN, IBAN; tutarlı persona ve şirket; formu tek tıkla doldurma, önizleme, geri alma; toplu CSV / XLSX.",
  "version": "2.0.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Data Helper"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Data Helper popup'ını aç"
    },
    "fill-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Odaktaki formu doldur"
    },
    "fill-field": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Odaktaki alanı doldur"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
